{
  "name": "pjpscriv.co.nz",
  "description": "Peter's personal website",
  "scripts": {
    "start": "node scripts/run-hugo.js server --noHTTPCache",
    "build": "node scripts/run-hugo.js && npm run generate:og && npm run format:public",
    "format:public": "prettier --ignore-path .prettierignore --write \"public/**/*.html\"",
    "generate:og": "node scripts/og/generate-og.js",
    "check:og": "node scripts/og/check-og.js",
    "test:og": "node scripts/run-hugo.js --quiet && node scripts/og/generate-og.js --out og-test --flat --clean",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "print:cv": "node scripts/print-cv.js",
    "print:card": "node scripts/print-card.js",
    "fonts:fetch": "node scripts/fetch-fonts.js",
    "fonts:fetch-og": "node scripts/og/fetch-og-assets.js",
    "validate:html": "node scripts/validate-html.js",
    "screenshot": "node scripts/screenshot.js --mode light",
    "screenshot:dark": "node scripts/screenshot.js --mode dark"
  },
  "devDependencies": {
    "html-validator": "^6.0.1",
    "playwright": "^1.47.0",
    "prettier": "^3.9.6",
    "satori": "^0.47.1",
    "sharp": "^0.35.4",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0"
  }
}
